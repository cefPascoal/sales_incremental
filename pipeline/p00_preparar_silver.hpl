<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>p00_preparar_silver</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
  </info>
  <transform>
    <type>RowGenerator</type>
    <name>Generate setup row</name>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <limit>1</limit>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Set SQL file path</name>
    <fields>
      <field>
        <name>sql_file</name>
        <variable>${PROJECT_HOME}/sql/01_create_silver_vendas.sql</variable>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>256</xloc><yloc>96</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ExecSqlRow</type>
    <name>Create Silver table</name>
    <sql_field>sql_file</sql_field>
    <connection>pg_sales_incremental</connection>
    <sendOneStatement>N</sendOneStatement>
    <sqlFromfile>Y</sqlFromfile>
    <commit>1</commit>
    <updatefield/>
    <insertfield/>
    <deletefield/>
    <readfield/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>448</xloc><yloc>96</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <order>
    <hop><from>Generate setup row</from><to>Set SQL file path</to><enabled>Y</enabled></hop>
    <hop><from>Set SQL file path</from><to>Create Silver table</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
</pipeline>
