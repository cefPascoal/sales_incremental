    <created_date>2026/10/23 17:40:25.803</created_date>
    <modified_date>2026/10/23 17:40:25.803</modified_date>
  </info>
  <transform>
    <type>GetFileNames</type>
    <name>Get file names</name>
    <file>
      <name>${PASTA_INPUT}</name>
      <filemask>.*\.csv$</filemask>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <filter>
      <filterfiletype>all_files</filterfiletype>
    </filter>
    <rownum>N</rownum>
    <rownum_field/>
    <filename_Field/>
    <wildcard_Field/>
    <exclude_wildcard_Field/>
    <filefield>N</filefield>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <isaddresult>Y</isaddresult>
    <limit>0</limit>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <raiseAnExceptionIfNoFile>N</raiseAnExceptionIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Database lookup</name>
    <connection>pg_sales_incremental</connection>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>control</schema>
      <table>file_ingestion</table>
      <key>
        <name>filename</name>
        <name2/>
        <condition>=</condition>
        <field>nome_ficheiro</field>
      </key>
      <value>
        <name>nome_ficheiro</name>
        <rename>nome_ficheiro</rename>
        <default/>
        <type>String</type>
        <trim_type>none</trim_type>
      </value>
      <value>
        <name>status</name>
        <rename>status</rename>
        <default/>
        <type>String</type>
        <trim_type>none</trim_type>
      </value>
      <value>
        <name>started_at</name>
        <rename>started_at</rename>
        <default/>
        <type>Timestamp</type>
        <trim_type>none</trim_type>
      </value>
      <value>
        <name>n_rejeitadas</name>
        <rename>n_rejeitadas</rename>
        <default/>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <value>
        <name>data_fim</name>
        <rename>data_fim</rename>
        <default/>
        <type>Timestamp</type>
        <trim_type>none</trim_type>
      </value>
      <value>
        <name>estado</name>
        <rename>estado</rename>
        <default/>
        <type>String</type>
        <trim_type>none</trim_type>
      </value>
      <value>
        <name>mensagem_erro</name>
        <rename>mensagem_erro</rename>
        <default/>
        <type>String</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Filter rows</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>status</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>COMPLETED</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
        <conditions/>
      </condition>
    </compare>
    <send_true_to>Select values sucess</send_true_to>
    <send_false_to>Select values failed</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>400</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
