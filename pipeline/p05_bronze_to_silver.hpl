<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>FICHEIRO</name>
        <description>Ficheiro de Bronze a harmonizar; vazio processa todos</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>p05_bronze_to_silver</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/10/31 21:54:40.721</created_date>
    <modified_date>2026/10/31 21:54:40.721</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read bronze sales</name>
    <sql>WITH source_rows AS (
  SELECT v.*, row_to_json(v)::text AS error_row
  FROM bronze.vendas v
  WHERE '${FICHEIRO}' = '' OR v.nome_ficheiro = '${FICHEIRO}'
),
normalized AS (
  SELECT source_rows.*,
    CASE
      WHEN btrim(data) ~ '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'
        THEN CASE
          WHEN to_char(to_date(btrim(data), 'YYYY-MM-DD'), 'YYYY-MM-DD') = btrim(data)
            THEN to_char(to_date(btrim(data), 'YYYY-MM-DD'), 'DD/MM/YYYY')
          ELSE btrim(data)
        END
      ELSE btrim(data)
    END AS data_normalizada
  FROM source_rows
),
checked AS (
  SELECT normalized.*,
    CASE
      WHEN data_normalizada ~ '^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}$'
        THEN to_char(to_date(data_normalizada, 'DD/MM/YYYY'), 'DD/MM/YYYY') = data_normalizada
      ELSE FALSE
    END AS data_valida,
    (NULLIF(btrim(loja_nome), '') IS NOT NULL) AS loja_valida,
    COALESCE(
      btrim(hora) ~ '^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$'
      AND btrim(linha) ~ '^[0-9]+$'
      AND btrim(quantidade) ~ '^[0-9]+$'
      AND btrim(preco_unit) ~ '^[0-9]+([.][0-9]{1,2})?$'
      AND btrim(desconto_pct) ~ '^[0-9]+([.][0-9]{1,4})?$'
      AND btrim(valor_desconto) ~ '^[0-9]+([.][0-9]{1,2})?$'
      AND btrim(total_linha) ~ '^[0-9]+([.][0-9]{1,2})?$'
      AND CASE
        WHEN btrim(timestamp_envio) ~ '^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4} ([01][0-9]|2[0-3]):[0-5][0-9]$'
          THEN to_char(to_date(substring(btrim(timestamp_envio) from 1 for 10), 'DD/MM/YYYY'), 'DD/MM/YYYY')
            = substring(btrim(timestamp_envio) from 1 for 10)
        ELSE FALSE
      END,
      FALSE
    ) AS restantes_validas
  FROM normalized
)
SELECT empresa, loja_id, loja_nome, cidade, data_normalizada AS data,
  hora, id_venda, linha, sku, produto, categoria, quantidade, preco_unit,
  desconto_pct, valor_desconto, total_linha, metodo_pagamento, vendedor,
  timestamp_envio, nome_ficheiro, error_row,
  CASE WHEN data_valida AND loja_valida AND restantes_validas THEN 'Y' ELSE 'N' END AS dados_validos,
  NULLIF(concat_ws('; ',
    CASE WHEN NOT data_valida THEN 'DTA001: data inválida; esperado dd/MM/aaaa' END,
    CASE WHEN NOT loja_valida THEN 'LJ001: loja_nome obrigatório' END,
    CASE WHEN NOT restantes_validas THEN 'SILVER001: um ou mais campos têm formato/tipo inválido' END
  ), '') AS error_description,
  NULLIF(concat_ws('+',
    CASE WHEN NOT data_valida THEN 'DTA001' END,
    CASE WHEN NOT loja_valida THEN 'LJ001' END,
    CASE WHEN NOT restantes_validas THEN 'SILVER001' END
  ), '') AS error_code
FROM checked</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
