<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name> FILE_NAME</name>
        <description> Arquivo a processar</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>02_read_sales</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/10/06 22:21:17.947</created_date>
    <modified_date>2026/10/06 22:21:17.947</modified_date>
  </info>
  <transform>
    <type>GetFileNames</type>
    <name>Get file names</name>
    <file>
      <name>${PROJECT_HOME}/data/processed</name>
      <filemask>.*\.csv</filemask>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <filter>
      <filterfiletype>all_files</filterfiletype>
    </filter>
    <rownum>N</rownum>
    <rownum_field/>
    <filename_Field/>
    <wildcard_Field/>
    <exclude_wildcard_Field/>
    <filefield>N</filefield>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <isaddresult>Y</isaddresult>
    <limit>0</limit>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <raiseAnExceptionIfNoFile>Y</raiseAnExceptionIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>192</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Database lookup</name>
    <connection>pg_sales_incremental</connection>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>control</schema>
      <table>file_ingestion</table>
      <key>
        <name>filename</name>
        <name2/>
        <condition>=</condition>
        <field>filename</field>
      </key>
      <value>
        <name>status</name>
        <rename>file_status</rename>
        <default/>
        <type/>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>416</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Filter rows</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>file_status</leftvalue>
        <function>IS NULL</function>
        <conditions/>
      </condition>
    </compare>
    <send_true_to>Copy rows to result</send_true_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>RowsToResult</type>
    <name>Copy rows to result</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>832</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Get file names</from>
      <to>Database lookup</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Database lookup</from>
      <to>Filter rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filter rows</from>
      <to>Copy rows to result</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
